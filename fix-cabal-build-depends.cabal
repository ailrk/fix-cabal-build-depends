cabal-version:      3.0
name:               fix-cabal-build-depends
version:            0.1.0.0
synopsis:           Run cabal build in a loop and add missing build-depends automatically
license:            MIT
build-type:         Simple
author:             Ailrk
maintainer:         jimmy123good@gmail.com
category:           Development
extra-doc-files:    README.md

common shared
    default-language: Haskell2010
    ghc-options:      -Wall

library
    import:           shared
    hs-source-dirs:   src
    exposed-modules:  FixCabalDeps.Types
                      FixCabalDeps.Parse
                      FixCabalDeps.Edit
    build-depends:    base >=4.14 && <5

executable fix-cabal-build-depends
    import:           shared
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:    base >=4.14 && <5,
                      fix-cabal-build-depends,
                      directory,
                      filepath,
                      process

test-suite spec
    import:           shared
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    build-depends:    base >=4.14 && <5,
                      fix-cabal-build-depends
